# Copie ce fichier en ".env" (à la racine du repo) et remplis les valeurs qui
# t'intéressent — évite de devoir les répéter à chaque `npm start`/`npm run dev`.
# ".env" n'est jamais commité (voir .gitignore) ; ce fichier "*.example" l'est,
# comme modèle.
#
# Rien n'est obligatoire : une ligne absente ou vide se comporte exactement
# comme la variable d'environnement non définie (voir README pour le détail
# de chaque variable).

# --- Serveur ---
# PORT=3000

# --- Données de jeu (parties, profils, équipes) ---
# DATA_DIR=
# DATA_FILE=

# --- Comptes (fichier séparé de data.json, pour sauvegarder/versionner
#     indépendamment ; retombe sur DATA_DIR si USERS_DATA_DIR est vide) ---
# USERS_DATA_DIR=
# USERS_DATA_FILE=

# --- Sauvegardes automatiques de data.json/users.json (copies horodatées dans
#     BACKUP_DIR, purgées au-delà de BACKUP_RETENTION sauvegardes) ---
# BACKUP_DIR=
# BACKUP_RETENTION=30
# BACKUP_INTERVAL_HOURS=24

# --- HTTPS direct (sans reverse proxy) ---
# SSL_KEY_PATH=
# SSL_CERT_PATH=
# SSL_CA_PATH=
# HTTP_REDIRECT_PORT=

# --- Bootstrap du premier compte admin (sinon, à créer via /login.html) ---
# EVA_ADMIN_USERNAME=
# EVA_ADMIN_PASSWORD=

# --- Inscription publique (désactivée tant que les deux ne sont pas définies) ---
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Copie ce fichier en ".env" (à la racine du repo) et remplis les valeurs qui
# t'intéressent — évite de devoir les répéter à chaque `npm start`/`npm run dev`.
# ".env" n'est jamais commité (voir .gitignore) ; ce fichier "*.example" l'est,
# comme modèle.
#
# Rien n'est obligatoire : une ligne absente ou vide se comporte exactement
# comme la variable d'environnement non définie (voir README pour le détail
# de chaque variable).

# --- Serveur ---
# PORT=3000

# --- Données de jeu (parties, profils, équipes) ---
# DATA_DIR=
# DATA_FILE=

# --- Comptes (fichier séparé de data.json, pour sauvegarder/versionner
#     indépendamment ; retombe sur DATA_DIR si USERS_DATA_DIR est vide) ---
# USERS_DATA_DIR=
# USERS_DATA_FILE=

# --- Sessions ouvertes (fichier séparé aussi de users.json : un jeton de session volé donne
#     un accès complet SANS mot de passe, au moins aussi sensible qu'un hash de mot de passe ;
#     retombe sur DATA_DIR si SESSIONS_DATA_DIR est vide). Persistées pour qu'un redémarrage
#     du serveur (déploiement, crash) ne déconnecte plus tout le monde d'un coup. ---
# SESSIONS_DATA_DIR=
# SESSIONS_DATA_FILE=

# --- Sauvegardes automatiques de data.json/users.json (copies horodatées dans
#     BACKUP_DIR, purgées au-delà de BACKUP_RETENTION sauvegardes) ---
# BACKUP_DIR=
# BACKUP_RETENTION=30
# BACKUP_INTERVAL_HOURS=24

# --- HTTPS direct (sans reverse proxy) ---
# SSL_KEY_PATH=
# SSL_CERT_PATH=
# SSL_CA_PATH=
# HTTP_REDIRECT_PORT=

# --- Bootstrap du premier compte admin (sinon, à créer via /login.html) ---
# EVA_ADMIN_USERNAME=
# EVA_ADMIN_PASSWORD=

# --- Inscription publique (désactivée tant que les deux ne sont pas définies) ---
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Limitation des tentatives de connexion (anti brute-force sur /api/login) ---
# LOGIN_RATE_LIMIT_MAX=5
# LOGIN_RATE_LIMIT_MINUTES=15

# --- Si ce serveur tourne derrière un reverse proxy DE CONFIANCE (Caddy/nginx, voir README)
#     qui pose lui-même l'en-tête X-Forwarded-For : active la vraie IP du client pour le
#     rate-limiting ci-dessus (sinon toutes les requêtes semblent venir du proxy lui-même,
#     et un seul utilisateur qui se trompe de mot de passe bloquerait tout le monde). NE PAS
#     activer sans reverse proxy réel devant : un client pourrait alors positionner cet
#     en-tête lui-même et se faire passer pour une IP différente à chaque tentative. ---
# TRUST_PROXY=

# --- CORS : à définir UNIQUEMENT si le frontend est hébergé ailleurs que ce backend
#     (ex: GitHub Pages, voir README) — une ou plusieurs origines séparées par des
#     virgules. Active aussi le cookie de session en SameSite=None (obligatoire pour
#     qu'il parte sur une requête cross-site), qui exige à son tour Secure : le backend
#     doit donc déjà tourner en HTTPS. Laisser vide pour un déploiement même-origine
#     classique (npm start sert le frontend lui-même) — comportement par défaut inchangé.
# CORS_ORIGIN=https://tonpseudo.github.io

# --- Mode API seule : ce serveur ne sert alors QUE /api/*, jamais frontend/dist ni
#     login.html (404 explicite sinon) — inutile de lancer `npm run build` sur cette machine
#     dans ce mode. Pour le cas où le frontend vit uniquement sur GitHub Pages (voir README) ;
#     pense à définir CORS_ORIGIN ci-dessus vers cette origine GitHub Pages, sinon le
#     frontend distant ne pourra pas appeler cette API. ---
# BACKEND_ONLY=

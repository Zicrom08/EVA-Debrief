{
  "name": "eva-debrief",
  "version": "1.0.0",
  "description": "EVA Debrief — historique de parties, statistiques de saison et comparatifs d'équipe pour EVA, backend + frontend auto-hébergés, sans dépendance native ni base de données externe.",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "node --watch backend/server.js",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "start": "node backend/server.js"
  },
  "keywords": ["eva", "gaming-stats", "self-hosted", "express", "dashboard"],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
